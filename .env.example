# Copy to .env and fill in:  cp .env.example .env
# .env is gitignored. config.yaml reads these via ${VAR} references.

# API key for Claude (default model; https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# API key for Google Gemini, if you switch config.yaml to the Gemini block
# (https://aistudio.google.com/apikey)
# GEMINI_API_KEY=your-gemini-api-key-here

# Optional overrides of the model/endpoint chosen in config.yaml
# LLM_ID=claude-haiku-5-5
# LLM_BASE_URL=https://api.anthropic.com/v1/
